# Copy this file to .env.local and fill in the values.
# Restart the dev server after changing .env.local.

# Required for the contact form to send. From https://resend.com/api-keys
RESEND_API_KEY=re_your_key

# Optional. Until irishwebdeveloper is verified in Resend, leave this unset.
# Mail then comes from onboarding@resend.dev, which only delivers to the
# address on the Resend account. After the domain is verified, set a sender:
# RESEND_FROM=irishwebdeveloper <hello@irishwebdeveloper.ie>
